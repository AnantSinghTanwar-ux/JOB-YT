# Application
NODE_ENV=development
PORT=5001
REQUIRE_DB=true

# Database [CRITICAL]
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiring_platform
DB_USER=postgres
DB_PASSWORD=your_db_password
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/hiring_platform"
DB_SSL=false

# Redis [RECOMMENDED]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL="redis://default:password@localhost:6379"

# JWT [CRITICAL]
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3001

# Rate Limits (development-friendly defaults)
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=200

# Credits
REGISTRATION_CREDIT_AMOUNT=50
JOB_POSTING_CREDIT_COST=10
LOW_CREDIT_THRESHOLD=10

# Resume Parser
PYTHON_RESUME_PARSER_URL=http://localhost:8000/parse
PYTHON_RESUME_PARSER_TIMEOUT_MS=8000
PYTHON_RESUME_PARSER_API_KEY=your_parser_api_key

# SMTP / Email Configuration [OPTIONAL]
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Hiring Platform" <your_email@gmail.com>

# EmailJS Configuration [OPTIONAL]
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# OAuth [OPTIONAL]
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/oauth/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/callback?provider=linkedin

# Storage (local, cloudinary, or s3) [OPTIONAL]
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay [OPTIONAL]
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Providers [OPTIONAL]
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.3
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=your_gemini_api_key

# Embeddings [OPTIONAL]
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
HUGGINGFACE_API_KEY=your_huggingface_api_key

# AWS S3 Configuration (if STORAGE_TYPE=s3) [OPTIONAL]
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_CLOUDFRONT_URL=https://your-cloudfront-id.cloudfront.net

# Firebase [OPTIONAL]
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/service-account.json

# Misc
AUTO_VERIFY_EMAIL_ON_REGISTER=true
ENABLE_SEMANTIC_SCORING=true
LOG_LEVEL=info
